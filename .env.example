# Supabase público: puede usarse en el cliente junto con políticas RLS
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Exclusivo del backend de Vercel. Usar una clave sb_secret nueva, nunca service_role
SUPABASE_SECRET_KEY=

# Se generará antes del primer despliegue público
APP_SECRET=

# URL pública de producción, por ejemplo https://familia-en-juego.vercel.app
PUBLIC_APP_URL=
