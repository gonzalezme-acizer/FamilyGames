{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{native/**,public/audio/**,*.command}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/events", "destination": "/api/index.py" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/:asset*", "destination": "/public/:asset*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "screen-wake-lock=(self)" }
      ]
    }
  ]
}
